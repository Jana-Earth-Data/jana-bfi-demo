# ============================================================================
# .env.local  —  Jana BFI Demo environment variables
# ============================================================================
# Copy this file to `.env.local` (gitignored) and fill in the blanks.
# Next.js loads .env.local automatically in dev + when running the container.
#
# Do NOT commit .env.local. Never put real Supabase or admin tokens in
# .env.local.example (this file is version-controlled).
#
# For OFFLINE demo mode (docker-compose.offline.yml), you do NOT need to fill
# in Supabase or upstream API vars — the offline compose sets its own values
# in-line. You only need SEED_ADMIN_TOKEN if you want the same value in both
# modes; otherwise the offline compose falls back to a local default.
# ============================================================================


# ----------------------------------------------------------------------------
# Upstream Jana APIs (used only when NEXT_PUBLIC_DEMO_USE_MOCKS=false)
# ----------------------------------------------------------------------------
# Point at Jana's live REST + auth surfaces. When mocks are enabled these are
# ignored and the in-memory synthesizer + data/ snapshots serve everything.
# For live-data dev, ping #eng for the correct URLs.

NEXT_PUBLIC_API_URL=https://api-test.jana.earth
NEXT_PUBLIC_AUTH_URL=https://auth-dev.jana.earth


# ----------------------------------------------------------------------------
# Mock mode toggle
# ----------------------------------------------------------------------------
# true   → app uses the in-memory portfolio synthesizer + snapshots in data/.
#          Zero network calls to Jana. Safe for demos + air-gapped runs.
# false  → app calls the upstream Jana APIs above at request time.
#
# The offline docker-compose.offline.yml forces this to "true" at both build
# and runtime — so setting it here only affects dev + regular docker-compose.

NEXT_PUBLIC_DEMO_USE_MOCKS=false


# ----------------------------------------------------------------------------
# Supabase (persistence for demo state)
# ----------------------------------------------------------------------------
# Grab these from Supabase Studio → Project Settings → API.
#
#   URL                 the base project URL (looks like https://xxx.supabase.co)
#   ANON KEY            public, safe in the browser; used for read paths
#   SERVICE ROLE KEY    SERVER-SIDE ONLY. Bypasses RLS. Never expose to
#                       the browser or check into git.
#
# For OFFLINE mode the compose file supplies replacement values that point
# at a bundled Postgres+PostgREST — leave these blank if you only demo offline.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ----------------------------------------------------------------------------
# Admin endpoints gate
# ----------------------------------------------------------------------------
# One-off shared secret. All /api/admin/seed*, /api/admin/reset endpoints
# require ?token=<this value>. Pick any string 20+ chars; only readable to
# people you trust. Same value must live wherever you call the endpoints
# (your shell, docker-compose env, CI).
#
# The offline docker-compose.offline.yml reads this variable from your shell
# via ${SEED_ADMIN_TOKEN:-offline-demo-seed-token} — export it before booting
# if you want the dev value; otherwise the offline default kicks in.

SEED_ADMIN_TOKEN=


# ============================================================================
# NOT in this file (documented here for orientation)
# ============================================================================
# * tts.key            — OpenAI API key for scripts/generate-tour-audio.py.
#                        Lives at repo root, gitignored. Only needed when
#                        regenerating tour MP3s.
#
# * NODE_ENV           — Next.js sets this automatically (development /
#                        production / test). Don't set it manually.
#
# * PGRST_JWT_SECRET,
#   PostgREST/postgres —  Offline-only. Hardcoded in docker-compose.offline.yml
#                         since the stack is local-air-gap only.
# ============================================================================
