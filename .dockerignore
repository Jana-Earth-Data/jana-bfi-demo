# Build / IDE / OS artifacts
node_modules
.next
.git
.DS_Store
tsconfig.tsbuildinfo
coverage
dist

# Environment + secrets
.env
.env.*
!.env.local.example
*.key
tts.key*
*.pem
keys-do-not-commit/
.aws/

# Dev-only scripts and source inputs that are not needed at runtime
scripts/
# EXCEPTION: precompute-portfolio.ts runs during `next build` via the
# `prebuild` hook (see package.json) and MUST be in the build context.
# Without this, the build fails with ERR_MODULE_NOT_FOUND on the tsx run.
!scripts/precompute-portfolio.ts
data/_raw_*.csv
data/_raw_*.geojson

# Internal documentation (PDFs, sales notes, sanity checks, session context)
docs/

# Vercel-only artifacts
.vercel/

# Misc markdown (keep README so the deploy carries a top-level overview)
*.md
!README.md
