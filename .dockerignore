# Build / IDE / OS artifacts
node_modules
.next
.git
.DS_Store
tsconfig.tsbuildinfo
coverage
dist

# Environment + secrets
.env
.env.*
!.env.local.example
*.key
tts.key*
*.pem
keys-do-not-commit/
.aws/

# Dev-only scripts and source inputs that are not needed at runtime
scripts/
#
# EXCEPTIONS — anything the `prebuild` hook runs must be in the build context,
# or `docker build` dies with MODULE_NOT_FOUND before Next.js even starts.
#
# The convention, so this stops being whack-a-mole: build-time scripts are
# .mjs, dev-only tooling is .ts / .py / .sh. precompute-portfolio.ts predates
# the convention and keeps its own exception.
#
# scripts/check-dockerignore-build-scripts.mjs enforces this — it reads the
# prebuild chain from package.json and fails if any script in it would be
# excluded from the image.
!scripts/*.mjs
!scripts/precompute-portfolio.ts
data/_raw_*.csv
data/_raw_*.geojson

# Internal documentation (PDFs, sales notes, sanity checks, session context)
docs/

# Vercel-only artifacts
.vercel/

# Misc markdown (keep README so the deploy carries a top-level overview)
*.md
!README.md
